# CAPSULE environment configuration
# Copy this file to .env and update the values before local or production deployment.
# Never commit your real .env file to Git.

APP_ENV=development
PORT=5001
SESSION_COOKIE_SECURE=false
CAPSULE_ENABLE_DEMO_USERS=true
CAPSULE_SECRET_KEY=change-this-to-a-long-random-secret-key
CAPSULE_ADMIN_PASSWORD=change-me-admin
CAPSULE_DOCTOR_PASSWORD=change-me-doctor
CAPSULE_PHARMACIST_PASSWORD=change-me-pharmacist
CAPSULE_PATIENT_PASSWORD=change-me-patient
